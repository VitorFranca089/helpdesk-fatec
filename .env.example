# Copie para .env só se quiser mudar algum valor. Sem .env, valem os padrões abaixo.

# Portas no host (presas ao 127.0.0.1). Escolhidas para não colidir com os outros projetos
# da máquina, que usam 8000, 5173, 3000, 5000, 5432, 5433, 6379 e 7700.
FRONTEND_PORT=8700
BACKEND_PORT=8701

# Abaixo desta confiança no setor, o chamado vai para a fila de revisão humana.
LIMIAR_CONFIANCA=0.60

# Threads do PyTorch na CPU.
LAYA_THREADS=4
